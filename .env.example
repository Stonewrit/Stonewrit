# Stonewrit server configuration.
# Copy to .env for local development and adjust as needed.

# Postgres connection string. Point this at any Postgres instance; run
# `make migrate` (or `go run ./server/cmd/migrate up`) to create the schema.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/stonewrit?sslmode=disable

# Port the server binds to.
PORT=3002

# Max pooled database connections.
# DATABASE_POOL_MAX=30

# Log level: debug, info, warn, or error.
LOG_LEVEL=info

# Metered-overage tunables. Leave unset for the defaults shown. Shrink the
# boundaries to exercise the overage path locally, for example:
#   STARTER_INCLUDED_EVENTS=10
#   OVERAGE_UNIT_EVENTS=1
# Overage is uncapped (billed, never blocked) unless an organization sets an
# explicit spend cap.
# STARTER_INCLUDED_EVENTS=250000
# PRO_INCLUDED_EVENTS=5000000
# OVERAGE_UNIT_EVENTS=1000
# STARTER_OVERAGE_CENTS_PER_UNIT=60
# PRO_OVERAGE_CENTS_PER_UNIT=25
