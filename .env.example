# Stonewrit server configuration.
# Copy to .env for local development and adjust as needed.

# Postgres connection string. Point this at any Postgres instance; run
# `stonewrit migrate up` to create the schema.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/stonewrit?sslmode=disable

# Port the server binds to.
PORT=3002

# Log level: debug, info, warn, or error.
LOG_LEVEL=info

# Max pooled database connections.
# DATABASE_POOL_MAX=30

# Authentication. Off by default: the server runs open under a built-in default
# tenant so you can ingest immediately with no key and no seeding. Set this to
# true to require an API key (minted with `stonewrit key create`) on every
# request. Always turn this on for anything internet-facing.
# APIKEY_AUTH=true
